function render(p){
  const d=PAGES[p];
  document.querySelectorAll('.nav a').forEach(a=>a.classList.toggle('active',a.textContent.toLowerCase()===(d?p:'home')));
  if(!d){pg.classList.remove('open');return}
  pg.innerHTML=`<div class="wrap"><button class="back" data-home>← Back to home</button><h1>${d[0]}</h1><p class="lead">${d[1]}</p>${d[2]()}</div>`;
  pg.classList.add('open');
}
