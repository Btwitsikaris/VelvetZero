const W=()=>innerWidth,H=()=>innerHeight;
const narrow=()=>innerWidth<1200; // mobile / tablet layout
const intro={v:0},glEl=document.getElementById('gl');
const renderer=new THREE.WebGLRenderer({canvas:document.getElementById('gl'),alpha:true,antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
const scene=new THREE.Scene();
const camera=new THREE.PerspectiveCamera(30,1,.1,100);camera.position.z=12;
// reflective environment built in code
const envScene=new THREE.Scene();
envScene.add(new THREE.Mesh(new THREE.SphereGeometry(10,32,16),new THREE.MeshBasicMaterial({color:0x4a5258,side:THREE.BackSide})));
[[0,6,0,8,.5,8],[8,0,0,.6,8,4],[-8,1,3,.6,6,3],[0,-6,4,6,.4,2],[-8,-2,-2,.6,5,3],[3,3,9,5,.5,.5]].forEach(p=>{const m=new THREE.Mesh(new THREE.BoxGeometry(p[3],p[4],p[5]),new THREE.MeshBasicMaterial({color:0xffffff}));m.position.set(p[0],p[1],p[2]);envScene.add(m)});
scene.environment=new THREE.PMREMGenerator(renderer).fromScene(envScene).texture;
scene.add(new THREE.AmbientLight(0xffffff,.5));
const key=new THREE.DirectionalLight(0xffffff,1.1);key.position.set(3,5,6);scene.add(key);

// --- CAN ---
const THEMES={classic:{c1:'#2b2b2b',c2:'#050505',name:'DIET CLASSIC'},blue:{c1:'#262a30',c2:'#04070b',name:'ZERO LIME'}};
const lc=document.createElement('canvas');lc.width=1024;lc.height=512;
const labelTex=new THREE.CanvasTexture(lc);labelTex.anisotropy=8;
function drawLabel(k){
  const t=THEMES[k],g=lc.getContext('2d');
  const gr=g.createLinearGradient(0,0,0,512);gr.addColorStop(0,t.c1);gr.addColorStop(1,t.c2);
  g.fillStyle=gr;g.fillRect(0,0,1024,512);
  g.strokeStyle='rgba(220,230,235,.35)';g.lineWidth=1;
  for(let i=0;i<26;i++){g.beginPath();for(let x=0;x<=1024;x+=16){const y=256+Math.sin(x/70+i*.35)*(40+i*6)*Math.cos(x/300);x?g.lineTo(x,y):g.moveTo(x,y)}g.stroke()}
  g.fillStyle='#e8eef0';
  [[40,60,70,10],[330,30,50,8],[440,470,90,10],[690,70,60,8],[850,450,80,10],[120,480,60,8],[560,20,40,8],[960,260,50,8]].forEach(r=>g.fillRect(r[0],r[1],r[2],r[3]));
  g.textAlign='center';
  [256,768].forEach(x=>{
    g.save();g.translate(x,205);
    g.fillStyle='#fff';g.beginPath();g.ellipse(0,0,150,110,-.15,0,7);g.fill();
    g.fillStyle='#0b0b0b';g.beginPath();g.ellipse(0,0,138,98,-.15,0,7);g.fill();
    [[-45,15,60],[40,5,66]].forEach(c=>{const r=g.createRadialGradient(c[0]-20,c[1]-25,5,c[0],c[1],c[2]);r.addColorStop(0,'#ff9a9a');r.addColorStop(.3,'#e0152f');r.addColorStop(1,'#6e0614');g.fillStyle=r;g.beginPath();g.arc(c[0],c[1],c[2],0,7);g.fill();g.strokeStyle='#fff';g.lineWidth=5;g.stroke()});
    g.fillStyle='#2f9c4a';g.beginPath();g.ellipse(10,-85,42,16,-.5,0,7);g.fill();
    g.restore();
    g.fillStyle='#fff';g.font='86px Galada, cursive';g.fillText('Velvet Zero',x,398);
    g.font='600 34px Inter, sans-serif';g.fillText(t.name,x,452);
    g.font='500 24px Inter, sans-serif';g.fillStyle='#fbcfe8';g.fillText('ORIGINAL ZERO SUGAR',x,62);
  });
  labelTex.needsUpdate=true;
}
drawLabel('classic');document.fonts.load('100px Galada').then(()=>drawLabel(currentFlavor));
let currentFlavor='classic';
const metal=new THREE.MeshStandardMaterial({color:0xe6ecee,metalness:1,roughness:.18,envMapIntensity:1.4,side:THREE.DoubleSide});
const can=new THREE.Group();
const body=new THREE.Mesh(new THREE.CylinderGeometry(.9,.9,2.5,64,1,true),new THREE.MeshPhysicalMaterial({map:labelTex,metalness:.95,roughness:.3,envMapIntensity:1.5,clearcoat:.4,clearcoatRoughness:.2,side:THREE.DoubleSide}));
can.add(body);
const cap=pts=>new THREE.Mesh(new THREE.LatheGeometry(pts.map(p=>new THREE.Vector2(p[0],p[1])),64),metal);
const topCap=cap([[0,1.6],[.6,1.6],[.66,1.55],[.72,1.5],[.85,1.3],[.9,1.25]]);
const bot=cap([[.9,-1.25],[.85,-1.3],[.7,-1.5],[.62,-1.58],[0,-1.58]]);
const lid=new THREE.Mesh(new THREE.CylinderGeometry(.58,.58,.04,48),metal);lid.position.y=1.58;
const tab=new THREE.Mesh(new THREE.BoxGeometry(.4,.02,.22),metal);tab.position.set(0,1.62,0);
can.add(topCap,bot,lid,tab);
can.rotation.z=-.44;scene.add(can);

// --- BERRIES & LEAVES ---
const berrySpec=[[220,25,30],[100,60,42],[250,30,62],[140,15,48],[120,75,20],[180,45,75],[80,15,40,.7,-1],[70,50,55,.6,-1],[75,80,35,.7,-1]];
const cherryMat=new THREE.MeshPhysicalMaterial({color:0xc8102e,metalness:.05,roughness:.15,clearcoat:1,clearcoatRoughness:.05});
const stemMat=new THREE.MeshStandardMaterial({color:0x3a6b2a,roughness:.7});
const berries=berrySpec.map((s,i)=>{
  const g=new THREE.Group(),m=cherryMat.clone();
  const ball=new THREE.Mesh(new THREE.SphereGeometry(.5,32,24),m);ball.scale.y=.92;
  const stem=new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3([new THREE.Vector3(0,.4,0),new THREE.Vector3(.1,.8,0),new THREE.Vector3(.35,1.05,0)]),12,.03,6),stemMat);
  const crown=new THREE.Mesh(new THREE.TorusGeometry(.09,.03,6,5),new THREE.MeshStandardMaterial({color:0x1b2a55}));crown.position.y=.46;crown.rotation.x=Math.PI/2;crown.visible=false;
  g.add(ball,stem,crown);g.userData={ball,stem,crown,m};scene.add(g);
  return {g,px:s[0],hx:s[2]/100,hy:s[1]/100,front:s[4]!==-1,op:s[3]||1,ox:0,oy:0,rx:0,ry:0,bx:0,by:0,ang:Math.random()*360,k:0,sc:1,i};
});
const leafShape=new THREE.Shape();leafShape.moveTo(0,0);leafShape.quadraticCurveTo(.6,.4,0,1.5);leafShape.quadraticCurveTo(-.6,.4,0,0);
const leafMat=new THREE.MeshStandardMaterial({color:0x2fa35a,side:THREE.DoubleSide,roughness:.6});
const leaves=[[15,10,60],[80,40,140],[75,70,80],[20,85,120]].map(s=>{const m=new THREE.Mesh(new THREE.ShapeGeometry(leafShape),leafMat);m.material=leafMat.clone();m.material.transparent=true;m.material.opacity=s[2]>100?.4:1;scene.add(m);return {m,hx:s[0]/100,hy:s[1]/100,px:s[2]}});

function resize(){renderer.setSize(W(),H());camera.aspect=W()/H();camera.updateProjectionMatrix();can.scale.setScalar(narrow()?Math.min(.85,W()/700):Math.min(1.6,W()/700))}
addEventListener('resize',resize);resize();
const wh=()=>2*Math.tan(THREE.MathUtils.degToRad(15))*12; // world height at z=0
let mouse={x:0,y:0,px:-999,py:-999},cm={x:0,y:0},spin=0,switching=false;
addEventListener('mousemove',e=>{mouse.x=e.clientX/W()-.5;mouse.y=e.clientY/H()-.5;mouse.px=e.clientX;mouse.py=e.clientY});

function frame(){
  const t=Date.now()*.001,u=wh()/H(); // world units per px
  cm.x+=(mouse.x-cm.x)*.05;cm.y+=(mouse.y-cm.y)*.05;
  can.rotation.y=THREE.MathUtils.degToRad(cm.x*40+spin);
  can.rotation.x=THREE.MathUtils.degToRad(cm.y*20);
  can.position.y=Math.sin(t*Math.PI/3)*.1+(narrow()?wh()*.17:0); // on mobile the can lives in the top area, above the text
  berries.forEach(b=>{
    const cx=b.hx*W(),cy=b.hy*H()*(narrow()?.5:1),par=b.front?60:-30;
    let hx=cx+cm.x*par,hy=cy+cm.y*par;
    if(!switching){
      const dx=mouse.px-hx,dy=mouse.py-hy,d=Math.hypot(dx,dy);let tx=0,ty=0,sm=1;
      if(d<400){const f=(400-d)/400;tx=dx/d*f*-80;ty=dy/d*f*-80;sm=1+f*5}
      b.rx+=(tx-b.rx)*.1;b.ry+=(ty-b.ry)*.1;b.ang+=.2*sm;
    }
    const dur=[5,7,6,8,5.5,6.5,9,11,10][b.i%9],ph=(t+b.i*.7)*(Math.PI*2/dur);
    let x=hx+b.rx+b.bx,y=hy+b.ry+b.by+Math.sin(ph)*15;
    x+=(W()/2-x)*b.k;y+=(H()/2-y)*b.k;
    const z=b.front?1.5:-2,s=b.px*u*b.sc*(b.front?1:1.15)/1.0;
    b.g.position.set((x-W()/2)*u*(1+(b.front?-.12:.17)),-(y-H()/2)*u*(1+(b.front?-.12:.17)),z);
    b.g.scale.setScalar(s*.5*(narrow()?.5:1));
    b.g.rotation.set(b.ang*.02,b.ang*.017,THREE.MathUtils.degToRad(Math.cos(ph)*6)+b.ang*.004);
    b.g.userData.m.opacity=b.op*Math.min(1,b.sc*3);b.g.userData.m.transparent=true;
  });
  leaves.forEach((l,i)=>{
    const ph=(t+i*1.2)*(Math.PI*2/(10+i*2));
    l.m.position.set((l.hx*W()-W()/2-cm.x*15+Math.cos(ph*.5)*15)*u,-(l.hy*H()*(narrow()?.5:1)-H()/2-cm.y*15+Math.sin(ph)*20)*u,-5);
    l.m.scale.setScalar(l.px*u*1.0);l.m.rotation.z=Math.sin(ph*.3)*.4+i;l.m.rotation.y=t*.3+i;
  });
  glEl.style.opacity=intro.v*(narrow()?Math.max(0,1-scrollY/(H()*.45)):1); // fade the 3D scene out as the page scrolls on mobile
  renderer.render(scene,camera);requestAnimationFrame(frame);
}
frame();
gsap.to(intro,{v:1,duration:1.5,delay:.3});

// --- FLAVOR SWITCH ---
document.querySelectorAll('.card').forEach(c=>c.addEventListener('click',()=>{
  if(switching)return;
  document.querySelectorAll('.card').forEach(x=>x.classList.remove('active'));c.classList.add('active');
  switchFlavor(c.dataset.flavor);
}));
function switchFlavor(f){
  if(f===currentFlavor)return;switching=true;
  const blue=f==='blue',to=blue?{'--bg-inner':'#eef3f8','--bg-mid':'#d6e3ee','--bg-outer':'#b3c4d4'}:{'--bg-inner':'#f7f0e4','--bg-mid':'#ebe1d0','--bg-outer':'#cfc1a8'};
  gsap.to(document.body,{...to,duration:1.5,ease:'power2.inOut'});
  const so={v:0,b:0},cv=document.getElementById('gl');
  gsap.to(so,{v:360,b:15,duration:.6,ease:'power2.in',onUpdate:()=>{spin=so.v;cv.style.filter=`blur(${so.b}px)`},onComplete:()=>{
    currentFlavor=f;drawLabel(f);
    gsap.to(so,{v:720,b:0,duration:1.5,ease:'back.out(0.7)',onUpdate:()=>{spin=so.v;cv.style.filter=`blur(${so.b}px)`},onComplete:()=>{spin=0;cv.style.filter='none'}});
  }});
  let done=0;
  berries.forEach(b=>{
    const nx=(Math.random()-.5)*200,ny=(Math.random()-.5)*200;
    gsap.timeline()
    .to(b,{k:1,sc:.1,duration:.5,ease:'power2.in',onComplete:()=>{
      const d=b.g.userData;d.m.color.set(blue?0x2b4fd8:0xc8102e);d.stem.visible=!blue;d.crown.visible=blue;
    }})
    .to(b,{duration:.3})
    .to(b,{k:0,sc:1,bx:nx,by:ny,rx:0,ry:0,duration:.9,ease:'back.out(1.5)',onComplete:()=>{if(++done===berries.length)switching=false}});
  });
}

