function canSVG(c,w){
  const id='g'+Math.random().toString(36).slice(2,7);
  const body='M20 18H60C66 21 72 28 72 38V104C72 112 68 118 62 122Q40 130 18 122C12 118 8 112 8 104V38C8 28 14 21 20 18Z';
  let waves='';for(let i=0;i<5;i++){const y=108+i*3.4;waves+=`<path d="M6 ${y}Q23 ${y-7} 40 ${y}T74 ${y}" fill="none" stroke="#dfe7ea" stroke-width=".45" opacity="${.5-i*.07}"/>`}
  return `<svg viewBox="0 0 80 140" width="${w}"><defs><linearGradient id="${id}" x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="#050505"/><stop offset=".18" stop-color="#383c40"/><stop offset=".36" stop-color="#121314"/><stop offset=".78" stop-color="#0a0a0a"/><stop offset=".93" stop-color="#2c3034"/><stop offset="1" stop-color="#050505"/></linearGradient><clipPath id="${id}c"><path d="${body}"/></clipPath></defs><path d="M18 122Q40 130 62 122V126Q40 135 18 126Z" fill="#aab2b5"/><path d="${body}" fill="url(#${id})"/><g clip-path="url(#${id}c)"><g fill="#e8eef0"><rect x="12" y="30" width="9" height="1.5"/><rect x="58" y="38" width="8" height="1.5"/><rect x="11" y="68" width="6" height="1.3"/><rect x="62" y="64" width="8" height="1.3"/></g><text x="40" y="33" fill="#cfd6d8" font-family="Inter,sans-serif" font-size="4.4" letter-spacing="1.1" text-anchor="middle">ZERO SUGAR</text><circle cx="40" cy="50" r="15" fill="#0b0b0b" stroke="#e8eef0" stroke-width="1.3"/><circle cx="40" cy="50" r="12.6" fill="none" stroke="${c}" stroke-width="1.7" stroke-dasharray="23 56" transform="rotate(110 40 50)"/><path d="M41 42Q43 36 49 37" fill="none" stroke="#3fae5a" stroke-width="1"/><path d="M45 39Q49 33 54 36Q51 41 45 39Z" fill="#2f9c4a"/><circle cx="34.8" cy="53.6" r="5.6" fill="#d4122c" stroke="#fff" stroke-width=".8"/><circle cx="44.6" cy="51.4" r="6.2" fill="#d4122c" stroke="#fff" stroke-width=".8"/><circle cx="42.8" cy="48.8" r="1.4" fill="#fff" opacity=".65"/><circle cx="33" cy="51.5" r="1.2" fill="#fff" opacity=".65"/><text x="40" y="85" fill="#fff" font-family="Galada,cursive" font-size="14" text-anchor="middle">Velvet</text><text x="40" y="99" fill="#fff" font-family="Galada,cursive" font-size="14" text-anchor="middle">Zero</text><rect x="8" y="102" width="64" height="1.6" fill="${c}"/>${waves}<rect x="13" y="34" width="4.5" height="66" rx="2.2" fill="#fff" opacity=".2"/><rect x="63" y="40" width="1.8" height="58" rx=".9" fill="#fff" opacity=".13"/></g><ellipse cx="40" cy="17.5" rx="21" ry="4.6" fill="#cfd6d8"/><ellipse cx="40" cy="17.5" rx="16.5" ry="3.1" fill="#8f989b"/><ellipse cx="40" cy="17" rx="7" ry="1.4" fill="#cfd6d8" opacity=".8"/></svg>`;
}
